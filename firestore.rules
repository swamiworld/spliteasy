rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupDoc(gid) { return get(/databases/$(database)/documents/groups/$(gid)); }
    function isMember(gid) { return signedIn() && request.auth.uid in groupDoc(gid).data.memberIds; }

    match /groups/{gid} {
      // Light security: the group id is an unguessable random string, so anyone
      // holding the invite link may join. Listing is limited to your own groups.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;

      allow update: if signedIn() && (
        // existing members can edit the group (incl. their display names)
        request.auth.uid in resource.data.memberIds
        // anyone can add only themselves (join via invite link)
        || (request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']))
      );

      match /expenses/{eid} {
        allow read, delete: if isMember(gid);
        allow create, update: if isMember(gid)
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.type in ['expense', 'settlement']
          && request.resource.data.paidBy in groupDoc(gid).data.memberIds;
        // Note: splits summing to amount is enforced in the client only.
      }

      // Audit trail of adds, edits and deletes: append-only.
      match /log/{lid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
